    {
      "parameters": {
        "jsCode": "const event = $json.body ?? $json;\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nif (event.event_type !== 'consented_lead.created' || event.consent !== true) {\n  throw new Error('Rejected lead event: expected a consented lead-created event.');\n}\nif (!uuidPattern.test(event.event_id) || !uuidPattern.test(event.lead_id) || !uuidPattern.test(event.assessment_id)) {\n  throw new Error('Rejected lead event: invalid event or record identifier.');\n}\nreturn [{ json: {\n  accepted: true,\n  event_id: event.event_id,\n  task: {\n    type: 'student-lead-follow-up',\n    lead_id: event.lead_id,\n    assessment_id: event.assessment_id,\n    created_at: event.created_at,\n    status: 'ready-for-staff-review'\n  }\n} }];"
      },
