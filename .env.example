# Backend-only secrets. Keep real values in an ignored .env or secret manager.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25

# Optional backend configuration. Defaults to backend\growthpilot.db.
# GROWTHPILOT_DB_PATH=backend\growthpilot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# For a deployed frontend, set VITE_API_BASE_URL in the frontend build environment.
# Do not put secrets in VITE_* variables; Vite exposes them to browser code.
